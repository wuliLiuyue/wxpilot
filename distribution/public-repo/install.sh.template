#!/usr/bin/env bash
set -euo pipefail

repo="${WXP_GITHUB_REPO:-__PUBLIC_REPO__}"
version="${WXP_VERSION:-}"
install_dir="${WXP_INSTALL_DIR:-$HOME/.local/bin}"
daemon_dir="${WXP_DAEMON_DIR:-$HOME/.wxpilot/bin}"
release_base="${WXP_RELEASE_BASE_URL:-}"

usage() {
  cat <<'EOF'
Usage: install.sh [--version <tag>] [--repo <owner/name>] [--install-dir <dir>] [--daemon-dir <dir>]

Options:
  --version <tag>          Install a specific release tag
  --repo <owner/name>      Override the public GitHub repo
  --install-dir <dir>      CLI install directory (default: ~/.local/bin)
  --daemon-dir <dir>       Daemon install directory (default: ~/.wxpilot/bin)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)
      [[ $# -ge 2 ]] || { echo "missing value for --version" >&2; exit 1; }
      version="$2"
      shift 2
      ;;
    --repo)
      [[ $# -ge 2 ]] || { echo "missing value for --repo" >&2; exit 1; }
      repo="$2"
      shift 2
      ;;
    --install-dir)
      [[ $# -ge 2 ]] || { echo "missing value for --install-dir" >&2; exit 1; }
      install_dir="$2"
      shift 2
      ;;
    --daemon-dir)
      [[ $# -ge 2 ]] || { echo "missing value for --daemon-dir" >&2; exit 1; }
      daemon_dir="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

sha256_file() {
  local file="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
    return
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
    return
  fi

  echo "missing checksum tool: need shasum or sha256sum" >&2
  exit 1
}

detect_asset() {
  local os arch
  os="$(uname -s)"
  arch="$(uname -m)"

  [[ "$os" == "Darwin" ]] || {
    echo "wxpilot release currently supports macOS only" >&2
    exit 1
  }

  case "$arch" in
    arm64) echo "wxpilot-darwin-arm64.tar.gz" ;;
    x86_64) echo "wxpilot-darwin-x64.tar.gz" ;;
    *)
      echo "unsupported macOS architecture: $arch" >&2
      exit 1
      ;;
  esac
}

require_cmd curl
require_cmd tar
require_cmd install

asset="$(detect_asset)"

if [[ -z "$release_base" ]]; then
  if [[ -n "$version" ]]; then
    release_base="https://github.com/$repo/releases/download/$version"
  else
    release_base="https://github.com/$repo/releases/latest/download"
  fi
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

archive="$tmp/$asset"
checksums="$tmp/wxpilot-checksums.txt"

curl -fsSL "$release_base/$asset" -o "$archive"
curl -fsSL "$release_base/wxpilot-checksums.txt" -o "$checksums"

expected="$(awk -v target="$asset" '$2 == target { print $1 }' "$checksums")"
[[ -n "$expected" ]] || {
  echo "missing checksum entry for $asset" >&2
  exit 1
}

actual="$(sha256_file "$archive")"
[[ "$actual" == "$expected" ]] || {
  echo "checksum mismatch for $asset" >&2
  exit 1
}

tar -xzf "$archive" -C "$tmp"

[[ -f "$tmp/wxpilot" ]] || { echo "archive missing wxpilot" >&2; exit 1; }
[[ -f "$tmp/wxp-daemon" ]] || { echo "archive missing wxp-daemon" >&2; exit 1; }

install -d "$install_dir" "$daemon_dir"
install -m 755 "$tmp/wxpilot" "$install_dir/wxpilot"
install -m 755 "$tmp/wxp-daemon" "$daemon_dir/wxp-daemon"

echo "installed wxpilot from $asset"
echo "wxpilot -> $install_dir/wxpilot"
echo "wxp-daemon -> $daemon_dir/wxp-daemon"
echo "next step: run 'wxpilot activate <license-key>'"

if [[ ":${PATH:-}:" != *":$install_dir:"* ]]; then
  echo "PATH hint: add the following line to your shell profile"
  echo "export PATH=\"$install_dir:\$PATH\""
fi
