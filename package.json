{
  "name": "wxpilot-root",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "cd rust && cargo build",
    "test": "cd rust && cargo test --workspace",
    "lint": "cd rust && cargo fmt -- --check",
    "mcp:test": "pnpm --filter @wxpilot/mcp test",
    "mcp:typecheck": "pnpm --filter @wxpilot/mcp typecheck",
    "mcp:build": "pnpm --filter @wxpilot/mcp build",
    "shared:test": "pnpm --filter @wxpilot/shared test",
    "shared:typecheck": "pnpm --filter @wxpilot/shared typecheck",
    "shared:build": "pnpm --filter @wxpilot/shared build",
    "dsh:test": "pnpm --filter @wxpilot/dsh test",
    "dsh:typecheck": "pnpm --filter @wxpilot/dsh typecheck",
    "dsh:build": "pnpm --filter @wxpilot/dsh build",
    "web:dev": "pnpm --dir packages/web dev",
    "web:build": "pnpm --dir packages/web build",
    "web:preview": "pnpm --dir packages/web preview",
    "web:typecheck": "pnpm --dir packages/web typecheck"
  }
}
